<Application x:Class="PosNfce.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:products="clr-namespace:PosNfce.Desktop.Catalog.Products"
             xmlns:taxRules="clr-namespace:PosNfce.Desktop.Catalog.TaxRules"
             xmlns:issuer="clr-namespace:PosNfce.Desktop.Fiscal.Issuer">
    <Application.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PageBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="MenuBrush" Color="#1F2A37" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#2E3B4C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7B8794" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F9A825" />
        <SolidColorBrush x:Key="WarningBackBrush" Color="#FFF8E1" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Each page ViewModel is shown with its View -->
        <DataTemplate DataType="{x:Type products:ProductsViewModel}">
            <products:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type taxRules:TaxRulesViewModel}">
            <taxRules:TaxRulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type issuer:IssuerViewModel}">
            <issuer:IssuerView />
        </DataTemplate>

        <!-- Text -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="FormMessage" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WarningBackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Inputs -->
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#EEF0F2" />
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="24,7" />
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#D9DDE2" />
            <Setter Property="HorizontalGridLinesBrush" Value="#ECEEF1" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Resources>
</Application>
