<Window x:Class="PosNfce.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosNfce.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="POS NFC-e" Height="600" Width="1000" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource PageBrush}">
    <DockPanel>
        <!-- Side menu -->
        <Border DockPanel.Dock="Left" Width="200" Background="{StaticResource MenuBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                    <TextBlock Text="POS NFC-e" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Homologação" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,2,0,0"
                               ToolTip="Ambiente de testes da SEFAZ: as notas não têm valor fiscal." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Menu}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Style="{StaticResource MenuButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Current page: App.xaml maps each ViewModel to its View -->
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</Window>
