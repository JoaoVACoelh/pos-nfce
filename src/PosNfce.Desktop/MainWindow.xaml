<Window x:Class="PosNfce.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosNfce.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="POS NFC-e" Height="600" Width="1000" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="/Assets/app.ico" Background="{StaticResource PageBrush}">
    <!-- The header is the title bar: Windows still drags, snaps and resizes the window, the app draws it -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Root margin set in code-behind: a maximized window spills past the screen edge by its frame width -->
    <DockPanel x:Name="Root">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource MenuBrush}">
            <DockPanel LastChildFill="False">
                <Button x:Name="MenuToggle" DockPanel.Dock="Left" Command="{Binding ToggleMenuCommand}"
                        Style="{StaticResource HeaderIconButton}" Content="&#xE700;" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Mostrar ou esconder o menu" ToolTip="Mostrar ou esconder o menu" />
                <Image DockPanel.Dock="Left" Source="/Assets/app-64.png" Width="24" Height="24" Margin="4,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Left" Text="POS NFC-e" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border DockPanel.Dock="Left" Background="{StaticResource WarningBrush}" CornerRadius="10" Padding="10,2"
                        VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Ambiente de testes da SEFAZ: as notas não têm valor fiscal.">
                    <TextBlock Text="HOMOLOGAÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MenuBrush}" />
                </Border>

                <!-- Window buttons, Windows 11 style -->
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                        Click="OnClose" AutomationProperties.Name="Fechar" ToolTip="Fechar" />
                <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="OnMaximizeOrRestore" AutomationProperties.Name="Maximizar" ToolTip="Maximizar" />
                <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="OnMinimize" AutomationProperties.Name="Minimizar" ToolTip="Minimizar" />

                <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Foreground="#C9D1DB" FontSize="14"
                           VerticalAlignment="Center" Margin="16,0,20,0" />
            </DockPanel>
        </Border>

        <!-- Side menu -->
        <Border x:Name="SideMenu" DockPanel.Dock="Left" Width="200" Background="{StaticResource MenuBrush}" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="200" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Fixed width inside, so the items slide out of view instead of wrapping while the menu narrows -->
            <DockPanel Width="200" HorizontalAlignment="Right">
            <!-- Settings pinned to the bottom, apart from the daily screens -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource MenuHoverBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <Button x:Name="SettingsButton" DataContext="{Binding SettingsItem}" Style="{StaticResource MenuButton}"
                        AutomationProperties.Name="Configurações"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </Button>
            </Border>
            <ItemsControl ItemsSource="{Binding Menu}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Style="{StaticResource MenuButton}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Current page: App.xaml maps each ViewModel to its View -->
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</Window>
