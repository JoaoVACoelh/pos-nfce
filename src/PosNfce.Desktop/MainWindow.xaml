<Window x:Class="PosNfce.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosNfce.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="POS NFC-e" Height="600" Width="1000" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource PageBrush}">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource MenuBrush}">
            <DockPanel LastChildFill="False">
                <Button x:Name="MenuToggle" DockPanel.Dock="Left" Command="{Binding ToggleMenuCommand}"
                        Style="{StaticResource HeaderIconButton}" Content="&#xE700;"
                        AutomationProperties.Name="Mostrar ou esconder o menu" ToolTip="Mostrar ou esconder o menu" />
                <TextBlock DockPanel.Dock="Left" Text="POS NFC-e" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,12,0" />
                <Border DockPanel.Dock="Left" Background="{StaticResource WarningBrush}" CornerRadius="3" Padding="8,2"
                        VerticalAlignment="Center" ToolTip="Ambiente de testes da SEFAZ: as notas não têm valor fiscal.">
                    <TextBlock Text="HOMOLOGAÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MenuBrush}" />
                </Border>

                <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Foreground="#C9D1DB" FontSize="14"
                           VerticalAlignment="Center" Margin="16,0,20,0" />
            </DockPanel>
        </Border>

        <!-- Side menu -->
        <Border DockPanel.Dock="Left" Width="200" Background="{StaticResource MenuBrush}"
                Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Menu}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Style="{StaticResource MenuButton}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Current page: App.xaml maps each ViewModel to its View -->
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</Window>
