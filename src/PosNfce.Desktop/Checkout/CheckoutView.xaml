<UserControl x:Class="PosNfce.Desktop.Checkout.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PosNfce.Desktop.Checkout"
             xmlns:shared="clr-namespace:PosNfce.Desktop.Shared"
             xmlns:sales="clr-namespace:PosNfce.Checkout.Domain.Sales;assembly=PosNfce.Checkout.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:CheckoutViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <local:PaymentMethodLabelConverter x:Key="MethodLabel" />
        <shared:SelectedWhenEqualConverter x:Key="SelectedWhenEqual" />
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Shortcut" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding StartPaymentCommand}" />
        <KeyBinding Key="F3" Command="{Binding EditDiscountCommand}" />
        <KeyBinding Key="F5" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Cash}" />
        <KeyBinding Key="F6" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.CreditCard}" />
        <KeyBinding Key="F7" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.DebitCard}" />
        <KeyBinding Key="F8" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Pix}" />
        <KeyBinding Key="F9" Command="{Binding RemoveLastPaymentCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Scan and items -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Caixa" Style="{StaticResource PageTitle}" />

            <TextBox x:Name="ScanBox" DockPanel.Dock="Top" Text="{Binding Scan, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="26" Padding="10,8" PreviewKeyDown="OnScanKeyDown"
                     ToolTip="Leia o código de barras ou digite o código. Quantidade: 3*código">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                       Text="Leia o produto ou digite o código e tecle Enter. Quantidade: 3*código ou 0,350*código." />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding CanFinish, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="FinishButton" Content="Finalizar venda  (F2)" Command="{Binding StartPaymentCommand}"
                        Style="{StaticResource PrimaryButton}" Focusable="False" />
                <Button Content="Desconto  (F3)" Command="{Binding EditDiscountCommand}" Margin="8,0,0,0" Focusable="False" />
                <Button Content="Cancelar venda  (F4)" Click="OnCancelClick" Margin="8,0,0,0" Focusable="False" />
            </StackPanel>

            <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource FormMessage}" FontSize="15" />
            <TextBlock x:Name="LastSaleText" DockPanel.Dock="Top" Text="{Binding LastSale}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <Border Style="{StaticResource GridFrame}" Margin="0,12,0,0">
            <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Focusable="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="15" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Line}" Width="40" />
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity, StringFormat=0.####}" Width="Auto" MinWidth="45" />
                    <DataGridTextColumn Header="Un." Binding="{Binding Unit}" Width="Auto" MinWidth="40" />
                    <DataGridTextColumn Header="Preço" Binding="{Binding UnitPrice, StringFormat=C2}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="Auto" MinWidth="75" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>
        </DockPanel>

        <!-- Totals and payment -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaying}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Atalhos" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Enter  incluir item   ·   ↑ ↓  selecionar   ·   Del  remover item" />
                <TextBlock Style="{StaticResource Shortcut}" Text="F2  finalizar / concluir   ·   F3  desconto   ·   F4  cancelar venda" />
                <TextBlock Style="{StaticResource Shortcut}" Text="F5 dinheiro · F6 crédito · F7 débito · F8 PIX · F9 remover pagamento" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Esc  voltar" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Subtotal" Style="{StaticResource TotalLabel}" />
                        <TextBlock Text="{Binding Subtotal, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Desconto (F3)" Style="{StaticResource TotalLabel}" />
                        <TextBlock Text="{Binding Discount, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsEditingDiscount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Text="Novo desconto R$" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="DiscountBox" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyDiscountCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <Separator Margin="0,10" />
                    <Grid>
                        <TextBlock Text="TOTAL" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalText" Text="{Binding Total, StringFormat=C2}" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                    </Grid>

                    <!-- Payment -->
                    <StackPanel Visibility="{Binding IsPaying, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                        <TextBlock Text="Pagamento" Style="{StaticResource SectionTitle}" Margin="0" />
                        <UniformGrid Columns="2" Margin="0,8,-8,0">
                            <Button Style="{StaticResource OptionButton}" AutomationProperties.Name="Dinheiro"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Cash}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.Cash}}">
                                <TextBlock TextAlignment="Center">Dinheiro<LineBreak /><Run FontSize="11">F5</Run></TextBlock>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" AutomationProperties.Name="Crédito"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.CreditCard}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.CreditCard}}">
                                <TextBlock TextAlignment="Center">Crédito<LineBreak /><Run FontSize="11">F6</Run></TextBlock>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" AutomationProperties.Name="Débito"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.DebitCard}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.DebitCard}}">
                                <TextBlock TextAlignment="Center">Débito<LineBreak /><Run FontSize="11">F7</Run></TextBlock>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" AutomationProperties.Name="PIX"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Pix}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.Pix}}">
                                <TextBlock TextAlignment="Center">PIX<LineBreak /><Run FontSize="11">F8</Run></TextBlock>
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="{Binding PaymentMethodLabel, StringFormat='Valor em {0}'}" Margin="0,4,0,0" FontSize="14" />
                        <TextBox x:Name="PaymentAmountBox" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="24" Padding="8,6" Margin="0,6,0,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmPaymentCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="ConfirmPaymentButton" Content="{Binding ConfirmPaymentText}" Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource PrimaryButton}" Focusable="False" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                        <ItemsControl ItemsSource="{Binding Payments}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding Method, Converter={StaticResource MethodLabel}}" />
                                        <TextBlock Text="{Binding Amount, StringFormat=C2}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Remover último pagamento  (F9)" Command="{Binding RemoveLastPaymentCommand}" Focusable="False"
                                Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" Padding="8,3"
                                Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Falta" Style="{StaticResource TotalLabel}" />
                            <TextBlock x:Name="RemainingText" Text="{Binding Remaining, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Troco" Style="{StaticResource TotalLabel}" />
                            <TextBlock Text="{Binding Change, StringFormat=C2}" Style="{StaticResource TotalValue}" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
