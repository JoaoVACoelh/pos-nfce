<UserControl x:Class="PosNfce.Desktop.Checkout.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PosNfce.Desktop.Checkout"
             xmlns:shared="clr-namespace:PosNfce.Desktop.Shared"
             xmlns:sales="clr-namespace:PosNfce.Checkout.Domain.Sales;assembly=PosNfce.Checkout.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:CheckoutViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <local:PaymentMethodLabelConverter x:Key="MethodLabel" />
        <shared:SelectedWhenEqualConverter x:Key="SelectedWhenEqual" />
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- Cards of the status area ("Pago", "Venda concluída"): same size, so they swap without moving the list -->
        <Style x:Key="StatusCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <!-- Amounts in a card shrink to fit a narrow window: a cut value is useless to the cashier -->
        <Style x:Key="CardFit" TargetType="Viewbox">
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>
        <!-- "TROCO R$ 4,00": the number the cashier reads aloud; hidden when there is no change -->
        <Style x:Key="CardChange" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Error line of a card, in red; hidden when empty -->
        <Style x:Key="CardMessage" TargetType="TextBlock" BasedOn="{StaticResource FormMessage}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Detail line of a card (what to do next, NFC-e situation); gives way to the error line -->
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Shortcut" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding StartPaymentCommand}" />
        <KeyBinding Key="F3" Command="{Binding EditDiscountCommand}" />
        <KeyBinding Key="F5" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Cash}" />
        <KeyBinding Key="F6" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.CreditCard}" />
        <KeyBinding Key="F7" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.DebitCard}" />
        <KeyBinding Key="F8" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Pix}" />
        <KeyBinding Key="F9" Command="{Binding RemoveLastPaymentCommand}" />
        <KeyBinding Key="F10" Command="{Binding EditCpfCommand}" />
        <KeyBinding Key="F11" Command="{Binding EditQuantityCommand}" />
        <KeyBinding Key="F12" Command="{Binding SaleNfce.PrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Scan and items -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top">
                <!-- Sales whose NFC-e isn't authorized: their cards are gone, so this stays until they are sent -->
                <TextBlock x:Name="UnsentNoticeText" DockPanel.Dock="Right" Text="{Binding SaleNfce.UnsentNotice}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Caixa" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantidade (F11)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                <TextBox x:Name="QuantityBox" Grid.Row="1" Grid.Column="0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="26" Padding="10,8" HorizontalContentAlignment="Right"
                         ToolTip="Quantidade do próximo item. Tecle Enter para ir ao código; volta para 1 depois de incluir.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmQuantityCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Código do produto" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                <TextBox x:Name="ScanBox" Grid.Row="1" Grid.Column="2" Text="{Binding Scan, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="26" Padding="10,8" PreviewKeyDown="OnScanKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                       Text="Leia o código de barras ou digite o código e tecle Enter." />

            <!--
                Status area with a fixed height, so the item list never jumps: the action buttons and the message line,
                or, in the same place, the "Pago" card (until Enter closes the sale) and the "Venda concluída" card
                (until the next item is scanned).
            -->
            <Grid DockPanel.Dock="Top" Height="116" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsCard}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Wraps to a second row in a narrow window; the margin leaves room for the highlight ring -->
                    <WrapPanel Margin="4,4,0,0" Visibility="{Binding CanFinish, Converter={StaticResource BoolToVisibility}}">
                        <!-- Tag "Selected" draws the ring of the option Enter runs (empty code field, ← → to move it) -->
                        <Button x:Name="FinishButton" Content="Finalizar venda  (F2)" Command="{Binding StartPaymentCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Focusable="False" Tag="{Binding HighlightedAction, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static local:CheckoutAction.Finish}}" />
                        <Button x:Name="DiscountButton" Content="Desconto  (F3)" Command="{Binding EditDiscountCommand}" Margin="0,0,10,8" Focusable="False"
                                Tag="{Binding HighlightedAction, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static local:CheckoutAction.Discount}}" />
                        <Button x:Name="CpfButton" Content="CPF na nota  (F10)" Command="{Binding EditCpfCommand}" Margin="0,0,10,8" Focusable="False"
                                Tag="{Binding HighlightedAction, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static local:CheckoutAction.Cpf}}" />
                        <Button x:Name="CancelButton" Content="Cancelar venda  (F4)" Click="OnCancelClick" Margin="0,0,10,8" Focusable="False"
                                Tag="{Binding HighlightedAction, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static local:CheckoutAction.Cancel}}" />
                    </WrapPanel>
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" Style="{StaticResource FormMessage}" FontSize="15" Margin="0,0,0,0" />
                </StackPanel>

                <!-- Paid: change in big letters and the button that closes the sale -->
                <Border x:Name="PaidCard" Style="{StaticResource StatusCard}"
                        Visibility="{Binding IsPaid, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Concluir venda  (Enter)" Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Focusable="False" />
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource CardFit}">
                                <TextBlock x:Name="PaidText" Text="{Binding Total, StringFormat='Pago: {0:C2}.'}" Style="{StaticResource CardTitle}" />
                            </Viewbox>
                            <Viewbox Style="{StaticResource CardFit}">
                                <TextBlock Text="{Binding ChangeText}" Style="{StaticResource CardChange}" />
                            </Viewbox>
                            <!-- An error (e.g. Esc with payments) takes the place of the hint -->
                            <TextBlock Text="{Binding Message}" Style="{StaticResource CardMessage}" />
                            <TextBlock Text="Tecle Enter para concluir a venda." Style="{StaticResource CardHint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Sale closed: change, the NFC-e (sent in the background when automatic) and the button to print it -->
                <Border x:Name="LastSaleCard" Style="{StaticResource StatusCard}"
                        Visibility="{Binding HasLastSale, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button x:Name="PrintNfceButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                Content="{Binding SaleNfce.PrintText}" Command="{Binding SaleNfce.PrintCommand}"
                                Style="{StaticResource PrimaryButton}" Focusable="False" Tag="{Binding HighlightedAction, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static local:CheckoutAction.PrintNfce}}" />
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource CardFit}">
                                <TextBlock x:Name="LastSaleText" Text="{Binding LastSale}" Style="{StaticResource CardTitle}" />
                            </Viewbox>
                            <Viewbox Style="{StaticResource CardFit}">
                                <TextBlock x:Name="LastChangeText" Text="{Binding LastChange}" Style="{StaticResource CardChange}" />
                            </Viewbox>
                            <!-- An NFC-e error takes the place of its situation -->
                            <TextBlock x:Name="NfceMessageText" DataContext="{Binding SaleNfce}" Text="{Binding Message}"
                                       Style="{StaticResource CardMessage}" ToolTip="{Binding Message}" />
                            <TextBlock x:Name="NfceStatusText" DataContext="{Binding SaleNfce}" Text="{Binding Status}" Style="{StaticResource CardHint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GridFrame}" Margin="0,12,0,0">
            <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Focusable="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="15" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Line}" Width="40" />
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="80" />
                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity, StringFormat=0.####}" Width="Auto" MinWidth="45" />
                    <DataGridTextColumn Header="Un." Binding="{Binding Unit}" Width="Auto" MinWidth="40" />
                    <DataGridTextColumn Header="Preço" Binding="{Binding UnitPrice, StringFormat=C2}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="Auto" MinWidth="75" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>
        </DockPanel>

        <!-- Totals and payment -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaying}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Atalhos" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Enter  incluir item   ·   ↑ ↓  selecionar   ·   Del  remover item" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Campo vazio:  ← →  escolher a opção   ·   Enter  executar" />
                <TextBlock Style="{StaticResource Shortcut}" Text="F2  finalizar   ·   F3  desconto   ·   F4  cancelar venda" />
                <TextBlock Style="{StaticResource Shortcut}" Text="F5 dinheiro · F6 crédito · F7 débito · F8 PIX · F9 remover pagamento" />
                <TextBlock Style="{StaticResource Shortcut}" Text="F10  CPF na nota   ·   F11  quantidade   ·   F12  imprimir nota" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Quantidade também pode ir antes do código: 3*código" />
                <TextBlock Style="{StaticResource Shortcut}" Text="Esc  voltar" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Subtotal" Style="{StaticResource TotalLabel}" />
                        <TextBlock Text="{Binding Subtotal, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Desconto (F3)" Style="{StaticResource TotalLabel}" />
                        <TextBlock Text="{Binding Discount, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsEditingDiscount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Text="Novo desconto R$" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="DiscountBox" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyDiscountCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="CPF na nota (F10)" Style="{StaticResource TotalLabel}" />
                        <TextBlock x:Name="CustomerCpfText" Text="{Binding CustomerCpf}" Style="{StaticResource TotalValue}" FontSize="16" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsEditingCpf, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Text="CPF" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CpfBox" Text="{Binding CpfText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" MaxLength="14"
                                 ToolTip="Digite o CPF e tecle Enter. Vazio + Enter remove.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyCpfCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <Separator Margin="0,10" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="TOTAL" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
                            <TextBlock x:Name="TotalText" Text="{Binding Total, StringFormat=C2}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Viewbox>
                    </DockPanel>

                    <!-- Payment -->
                    <StackPanel Visibility="{Binding IsPaying, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                        <TextBlock Text="Pagamento" Style="{StaticResource SectionTitle}" Margin="0" />
                        <!-- One under the other, in the order ↑ ↓ follow -->
                        <StackPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource OptionButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Dinheiro"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Cash}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.Cash}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="F5" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                    <TextBlock Text="Dinheiro" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Crédito"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.CreditCard}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.CreditCard}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="F6" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                    <TextBlock Text="Crédito" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Débito"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.DebitCard}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.DebitCard}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="F7" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                    <TextBlock Text="Débito" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource OptionButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="PIX"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="{x:Static sales:PaymentMethod.Pix}"
                                    Tag="{Binding PaymentMethod, Converter={StaticResource SelectedWhenEqual}, ConverterParameter={x:Static sales:PaymentMethod.Pix}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="F8" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                    <TextBlock Text="PIX" />
                                </DockPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Shortcut}" Text="↑ ↓  escolher a forma   ·   Enter  lançar o valor" Margin="0,0,0,6" />
                        <TextBlock x:Name="PaymentMethodText" Text="{Binding PaymentMethodLabel, StringFormat='Valor em {0}'}" Margin="0,4,0,0" FontSize="14" />
                        <TextBox x:Name="PaymentAmountBox" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnPaymentAmountKeyDown"
                                 FontSize="24" Padding="8,6" Margin="0,6,0,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmPaymentCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="ConfirmPaymentButton" Content="{Binding ConfirmPaymentText}" Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource PrimaryButton}" Focusable="False" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                        <ItemsControl ItemsSource="{Binding Payments}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding Method, Converter={StaticResource MethodLabel}}" />
                                        <TextBlock Text="{Binding Amount, StringFormat=C2}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Remover último pagamento  (F9)" Command="{Binding RemoveLastPaymentCommand}" Focusable="False"
                                Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" Padding="8,3"
                                Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Falta" Style="{StaticResource TotalLabel}" />
                            <TextBlock x:Name="RemainingText" Text="{Binding Remaining, StringFormat=C2}" Style="{StaticResource TotalValue}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Troco" Style="{StaticResource TotalLabel}" />
                            <TextBlock Text="{Binding Change, StringFormat=C2}" Style="{StaticResource TotalValue}" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
