<UserControl x:Class="PosNfce.Desktop.Fiscal.Printer.PrinterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PosNfce.Desktop.Fiscal.Printer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:PrinterViewModel}"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Impressora" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="Impressora térmica do cupom (DANFCE). Funciona com qualquer impressora ESC/POS: Elgin, Epson, Bematech, Daruma, Tanca, Control iD e outras. Imprima a página de teste antes de salvar." />

            <Label Content="Conexão" Target="{Binding ElementName=ConnectionBox}" />
            <ComboBox x:Name="ConnectionBox" ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection}" DisplayMemberPath="Label" />

            <StackPanel Visibility="{Binding IsWindowsQueue, Converter={StaticResource BoolToVisibility}}">
                <Label Content="Impressora do Windows" Target="{Binding ElementName=PrinterNameBox}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Atualizar lista" Command="{Binding RefreshPrintersCommand}" Margin="8,0,0,0" />
                    <ComboBox x:Name="PrinterNameBox" ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding PrinterName}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Instale o driver do fabricante (ou o driver &quot;Generic / Text Only&quot; do Windows) e escolha a impressora aqui. O sistema envia os comandos direto, sem passar pela formatação do driver." />
            </StackPanel>

            <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="IP da impressora" Target="{Binding ElementName=HostBox}" />
                        <TextBox x:Name="HostBox" Text="{Binding Host}" MaxLength="255" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Porta" Target="{Binding ElementName=PortBox}" />
                        <TextBox x:Name="PortBox" Text="{Binding Port}" MaxLength="5" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="O IP aparece na página de configuração que a impressora imprime (geralmente segurando o botão de avanço ao ligar). A porta costuma ser 9100." />
            </StackPanel>

            <Label Content="Largura do papel" Target="{Binding ElementName=WidthBox}" />
            <ComboBox x:Name="WidthBox" ItemsSource="{Binding Widths}" SelectedItem="{Binding Width}" DisplayMemberPath="Label" />

            <Label Content="Acentuação (tabela de caracteres)" Target="{Binding ElementName=CodePageBox}" />
            <ComboBox x:Name="CodePageBox" ItemsSource="{Binding CodePages}" SelectedItem="{Binding CodePage}" DisplayMemberPath="Label" />
            <TextBlock Style="{StaticResource Hint}" Text="Se os acentos saírem como símbolos na página de teste, troque a tabela. &quot;Sem acentos&quot; sempre funciona." />

            <Label Content="QR Code" Target="{Binding ElementName=QrModeBox}" />
            <ComboBox x:Name="QrModeBox" ItemsSource="{Binding QrModes}" SelectedItem="{Binding QrMode}" DisplayMemberPath="Label" />

            <CheckBox x:Name="CutPaperBox" IsChecked="{Binding CutPaper}" Margin="0,16,0,0" FontSize="14" Content="Cortar o papel no fim do cupom" />
            <CheckBox x:Name="AutoPrintBox" IsChecked="{Binding PrintAfterAuthorization}" Margin="0,8,0,0" FontSize="14"
                      Content="Imprimir o cupom automaticamente depois que a NFC-e for autorizada" />

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="SavePrinterButton" Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="TestPageButton" Content="Imprimir página de teste" Command="{Binding PrintTestCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Text="{Binding Message}" Style="{StaticResource FormMessage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
