<Window x:Class="PosNfce.Desktop.Fiscal.Documents.DanfceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DANFCE" Width="520" Height="820" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button x:Name="PrintButton" Content="Imprimir..." Click="OnPrint" Style="{StaticResource PrimaryButton}" />
            <Button Content="Salvar como imagem..." Click="OnSaveImage" Margin="8,0,0,0" />
            <Button Content="Fechar" Click="OnClose" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <!-- White strip about the width of an 80 mm roll; this is what gets printed or saved. -->
            <Border x:Name="Receipt" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="14" HorizontalAlignment="Center">
                <StackPanel x:Name="ReceiptLines" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
